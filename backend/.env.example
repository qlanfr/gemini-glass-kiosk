# GlassKiosk Copilot - Environment Variables
# Copy this file to .env and fill in your values

# ============================================
# LOCAL DEVELOPMENT (Required)
# ============================================

# Google AI API Key (Required)
# Get from: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Gemini Model Settings
GEMINI_MODEL=gemini-2.0-flash

# ============================================
# GITHUB ACTIONS CI/CD (For Cloud Run Deploy)
# Set these in: GitHub Repo → Settings → Secrets
# ============================================
#
# GCP_PROJECT_ID=your-gcp-project-id
# GCP_SA_KEY={"type":"service_account",...}  (full JSON content)
# GOOGLE_API_KEY=your_google_api_key_here
#
# GCP Setup Commands:
# 1. gcloud artifacts repositories create glasskiosk --repository-format=docker --location=asia-northeast3
# 2. Create service account with roles: roles/run.admin, roles/artifactregistry.writer, roles/iam.serviceAccountUser
# 3. Download JSON key and paste full content into GCP_SA_KEY secret
